# SQS queue to poll
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/uw-local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave empty for real AWS. For local testing against elasticmq:
# AWS_ENDPOINT_URL=http://localhost:9324
AWS_ENDPOINT_URL=

# Poller behaviour
POLL_ENABLED=true
WAIT_TIME_SECONDS=20
VISIBILITY_TIMEOUT=300
MAX_MESSAGES=10
DELETE_AFTER_STORE=true

# SQLite location (inside container)
DB_PATH=/data/jobs.db

# Set when serving behind a reverse proxy prefix, e.g. /be/k-auto
ROOT_PATH=
